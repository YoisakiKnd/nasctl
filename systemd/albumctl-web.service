[Unit]
Description=albumctl read-only photo index web service
Documentation=file:/usr/local/share/doc/albumctl/RUNBOOK.md
After=network-online.target
Wants=network-online.target
# The media is expected to be mounted before the service starts. These are
# examples: replace with the actual filesystem or mount units for your array.
# Without this the service may start while the array is absent and serve an
# index whose originals are unreachable.
After=mnt-data.mount
Requires=mnt-data.mount

[Service]
Type=simple
User=albumctl
Group=albumctl

ExecStart=/usr/local/bin/albumctl serve --config /etc/albumctl/config.toml
ExecReload=/bin/kill -TERM $MAINPID

# ---- resource policy -------------------------------------------------------
# MemoryMax on this unit bounds the whole cgroup, not one process's RSS.
# 64 MiB matches guard.server_mem_max_mb; the two are meant to be equal, so the
# number is in one place in the config and repeated here because systemd is what
# actually enforces it.
MemoryAccounting=yes
MemoryHigh=48M
MemoryMax=64M
# No CPU ceiling: an idle web service should be free to answer a request
# promptly. It is the media worker that gets throttled, and it is a separate
# unit precisely so this one does not have to be.
CPUWeight=50

# The service never needs to write outside its state and cache directories.
# ProtectSystem=strict makes everything else read-only, and ReadWritePaths
# re-opens exactly those two. /mnt/data is left untouched, which is the point:
# the media tree is not writable by this unit even if the code tried.
ProtectSystem=strict
ReadWritePaths=/var/lib/albumctl /var/cache/albumctl
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

# ---- exit policy -----------------------------------------------------------
# Do NOT add Restart=always. A service that restarts itself in a loop while the
# machine is short of memory is the failure this project exists to avoid. A
# clean exit is honoured; a crash is visible in `systemctl status` and in the
# journal, and a human decides what to do.
Restart=no
TimeoutStopSec=15
# The service closes its listener and waits for in-flight requests up to
# server.shutdown_timeout before exiting.
KillSignal=SIGTERM
KillMode=mixed

# journald only. No log file to rotate, nothing written to the media tree.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=albumctl-web

[Install]
WantedBy=multi-user.target