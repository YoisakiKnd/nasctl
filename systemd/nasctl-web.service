[Unit]
Description=nasctl NAS console and optional anime automation
Documentation=file:/usr/local/share/doc/albumctl/HUB-DESIGN.md
Documentation=file:/usr/local/share/doc/albumctl/RUNBOOK.md
After=network-online.target
Wants=network-online.target

# The storage roots must be mounted before the console starts. Replace these with
# the actual mount or filesystem units for your array. Without them the console
# may start while the array is absent, and its file pages would report every root
# as unavailable - which is honest, but not what you want to see by accident.
# The unit does not *require* the mount: a console that starts and says "the
# volume is gone" is more useful during an incident than one that refuses to run.
After=mnt-data.mount

[Service]
Type=simple
User=nasctl
Group=nasctl

ExecStart=/usr/local/bin/nasctl serve --config /etc/albumctl/config.toml

# ---- resource policy -------------------------------------------------------
# This ceiling includes the NAS console, a bounded album supervisor, and its
# isolated decoder. It is a finite provisional deployment budget, not measured
# RAM use on your NAS. The decoder keeps its own 128 MiB default child ceiling;
# the outer task group adds 64 MiB for its supervisor. Measure on the target.
MemoryAccounting=yes
MemoryHigh=192M
MemoryMax=256M

# NAS moves itself to a supervisor child before enabling memory delegation.
# The gated album supervisor starts in a sibling task group, then establishes
# its own decoder group. No other service's cgroup is changed.
Delegate=yes

# Keep interactive requests responsive. Optional anime work is bounded by the
# application and shares this unit's resource limits.
CPUWeight=50
Nice=5

# ---- filesystem policy -----------------------------------------------------
# State/cache writes are required for users, jobs, indexes and thumbnails.
# Original media stays read-only unless an operator adds exact writable paths
# in a drop-in; application-level writable-root consent is also required.
StateDirectory=albumctl
StateDirectoryMode=0750
CacheDirectory=albumctl
CacheDirectoryMode=0750
ProtectSystem=strict
ReadWritePaths=/var/lib/albumctl /var/cache/albumctl
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=no
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# No SetUID/SetGID, no ptrace of other processes, and no ability to gain
# privileges. The console is not root and has no reason to be.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

# ---- exit policy -----------------------------------------------------------
# Do NOT add Restart=always or Restart=on-failure with a short delay. A console
# that restarts itself in a loop while the machine is short of memory is exactly
# the failure this project exists to avoid, and the console's own state
# reconciliation runs at startup - a restart loop would rewrite job history
# repeatedly.
#
# A clean exit is honoured. A crash is visible in `systemctl status` and in the
# journal, and a human decides what to do.
Restart=no
TimeoutStopSec=15
KillSignal=SIGTERM
# KillMode=mixed sends SIGTERM to the main process only, then SIGKILL to the
# whole cgroup if the grace period expires, including this service's owned
# album supervisor and decoder. No PID from old state is adopted or killed.
KillMode=mixed

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nasctl

# ---- hardening notes -------------------------------------------------------
# Local users and the private first-admin setup are documented in AUTH.md.
# Keep hub.setup=true or server.token in the base configuration. Bind validation
# still refuses public addresses unless explicitly enabled locally. Use HTTPS,
# Tailscale or a loopback SSH tunnel for remote access.

[Install]
WantedBy=multi-user.target
